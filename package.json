{
  "name": "openrank",
  "private": true,
  "version": "0.1.0",
  "description": "OpenRank - free, open-source, offline-first strength training with transparent strength ranks. No subscriptions. No locked ranks. No account required.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "node scripts/generate-ranking-fixtures.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}